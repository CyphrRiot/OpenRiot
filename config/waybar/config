/* OpenRiot Waybar Configuration */
/* OpenBSD / Sway — Single flat config */
/* NO includes, NO Hyprland modules, NO groups, NO separators */

{
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "margin-right": 8,
    "margin-left": 8,
    "margin-top": 3,
    "spacing": 8,
    "passthrough": false,
    "exclusive": true,
    "ipc": false,

    "modules-left": [
        "custom/openbsd",
        "sway/workspaces",
        "sway/window"
    ],

    "modules-center": [
        "clock",
        "custom/weather-emoji",
        "custom/notifications"
    ],

    "modules-right": [
        "custom/system-metrics",
        "custom/volume-bar",
        "custom/network",
        "custom/battery",
        "custom/openriot-update",
        "custom/power",
        "custom/lock"
    ],

    "custom/openbsd": {
        "format": "\udb80\udc3b",
        "on-click": "fuzzel",
        "on-click-right": "pkill fuzzel",
        "tooltip": true,
        "tooltip-format": "Left-click: App Launcher"
    },

    "custom/weather-emoji": {
        "format": "{}",
        "interval": 600,
        "exec": "$HOME/.local/share/openriot/config/waybar/scripts/weather-emoji-plain.sh",
        "tooltip": true
    },

    "custom/notifications": {
        "format": "{}",
        "return-type": "json",
        "interval": 3,
        "exec": "$HOME/.local/share/openriot/install/openriot --notify-waybar",
        "on-click": "$HOME/.local/share/openriot/install/openriot --notify-dismiss",
        "tooltip": true
    },

    "custom/system-metrics": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "$HOME/.local/share/openriot/config/waybar/scripts/system-metrics.sh",
        "on-click": "havoc htop",
        "tooltip": true
    },

    "custom/volume-bar": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-volume.sh",
        "on-click": "$HOME/.local/share/openriot/install/openriot --volume toggle",
        "on-scroll-up": "$HOME/.local/share/openriot/install/openriot --volume inc",
        "on-scroll-down": "$HOME/.local/share/openriot/install/openriot --volume dec",
        "tooltip": true
    },

    "custom/network": {
        "format": "{}",
        "return-type": "json",
        "interval": 300,
        "exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-network",
        "on-click": "$HOME/.local/share/openriot/config/waybar/scripts/wifi-selector.sh",
        "tooltip": true
    },

    "custom/battery": {
        "format": "{}",
        "return-type": "json",
        "interval": 30,
        "exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-battery.sh",
        "on-click-right": "$HOME/.local/share/openriot/install/openriot --power-menu",
        "tooltip": true
    },

    "custom/openriot-update": {
        "format": "{}",
        "return-type": "json",
        "interval": 300,
        "exec": "$HOME/.local/share/openriot/config/waybar/scripts/openriot-update.sh",
        "on-click": "$HOME/.local/share/openriot/config/waybar/scripts/openriot-update.sh --click",
        "tooltip": true
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "$HOME/.local/share/openriot/install/openriot --power-menu",
        "tooltip": false
    },

    "custom/lock": {
        "format": "🔒",
        "on-click": "swaylock -f",
        "tooltip": true,
        "tooltip-format": "Screen Lock"
    },

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "sort-by-number": true,
        "show-special": false,
        "format": "{icon}",
        "format-icons": {
            "focused": "●",
            "default": "○",
            "urgent": "●",
            "empty": "○"
        }
    },

    "sway/window": {
        "format": "{}",
        "max-length": 60
    },

    "clock": {
        "interval": 1,
        "format": "{:%A, %B %d - %I:%M %p}",
        "on-click": "$HOME/.local/share/openriot/install/openriot --swaybg-next",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 5,
        "show-passive-items": true
    }
}
