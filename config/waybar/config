/* OpenRiot Waybar Configuration */
/* OpenBSD / Sway - Single flat config for waybar 0.15.0 compatibility */

{
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "margin-right": 8,
    "margin-left": 8,
    "margin-top": 3,
    "spacing": 10,
    "passthrough": false,
    "exclusive": true,
    "ipc": false,

    "modules-left": [
        "custom/openbsd",
        "custom/separator#blank",
        "sway/workspaces",
        "custom/separator#blank",
        "sway/window"
    ],

    "modules-center": [
        "clock",
        "custom/separator#dot",
        "custom/weather-emoji",
        "custom/notifications"
    ],

    "modules-right": [
        "custom/separator#blank_3",
        "custom/rec-dot",
        "tray",
        "custom/separator#blank",
        "group/system-metrics",
        "custom/separator#blank",
        "custom/volume-bar",
        "custom/separator#blank",
        "custom/network",
        "custom/wireguard",
        "custom/separator#blank",
        "custom/battery",
        "custom/separator#blank",
        "custom/openriot-update",
        "custom/separator#blank",
        "custom/power",
        "custom/lock"
    ],

"temperature": {
	"interval": 10,
	"tooltip": true,

	"critical-threshold": 82,
	"format-critical": "{temperatureC}°{icon}",
	"format": "{temperatureC}°{icon}",
	"format-icons": [
		"󰈸"
	],
	"tooltip-format": "CPU Temperature: {temperatureC}°C",
	"on-click": "foot -e btop",
	"on-click-right": "foot -e btop"
},

"backlight": {
	"interval": 2,
	"align": 0,
	"rotate": 0,
	
	"format-icons": [
		" ",
		" ",
		" ",
		"󰃝 ",
		"󰃞 ",
		"󰃟 ",
		"󰃠 "
	],
	"format": "{icon}",
	
	"tooltip-format": "backlight {percent}%",
	"icon-size": 10,
	"on-click": "",
	"on-click-middle": "",
	"on-click-right": "",
	"on-update": "",
	"on-scroll-up": "$HOME/.local/share/openriot/install/openriot --brightness up",
	"on-scroll-down": "$HOME/.local/share/openriot/install/openriot --brightness down",
	"smooth-scrolling-threshold": 1
},

"backlight#2": {
  "device": "intel_backlight",
  "format": "{icon} {percent}%",
  "format-icons": ["", ""]
},

"battery": {
	
	"align": 0,
	"rotate": 0,
	
	
	"full-at": 100,
	"design-capacity": false,
	"states": {
		"good": 95,
		"warning": 30,
		"critical": 15
	},
	"format": "{icon} {capacity}%",
	"format-charging": " {capacity}%",
	"format-plugged": "󱘖 {capacity}%",
		"format-full": "{icon} {capacity}%",
	"format-icons": [
		"󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
	],
	"format-time": "{H}h {M}min",
	"tooltip": true,
	"tooltip-format": "{timeTo} {power}w",
	"on-click-right": "$HOME/.local/share/openriot/install/openriot --power-menu"
},

"bluetooth": {
	"format": " ",
	"format-disabled": "󰂳",
	"format-connected": "󰂱 {num_connections}",
	"tooltip-format": " {device_alias}",
	"tooltip-format-connected": "{device_enumerate}",
	"tooltip-format-enumerate-connected": " {device_alias} 󰂄{device_battery_percentage}%",
	"tooltip": true,
	"on-click": "blueberry"
},

"clock": {
	"interval": 1,
    "format": " {:%A • %B %d • %I:%M %p}",
    
	"format-alt": " {:%H:%M   %d %B, %A}",
	"on-click": "$HOME/.local/share/openriot/install/openriot --swaybg-next",
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
	"calendar": {
		"mode": "year",
		"mode-mon-col": 3,
		"weeks-pos": "right",
		"on-scroll": 1,
		"format": {
			"months": "<span color='#ffead3'><b>{}</b></span>",
			"days": "<span color='#ecc6d9'><b>{}</b></span>",
			"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
			"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
			"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
		}
	}
},

"actions": {
	"on-click-right": "mode",
	"on-click-forward": "tz_up",
	"on-click-backward": "tz_down",
	"on-scroll-up": "shift_up",
	"on-scroll-down": "shift_down"
},

"clock#2": {
    "format": " {:%I:%M %p}",
    
    "format-alt": "{:%A  |  %H:%M  |  %e %B}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
},

"clock#3": {
    "format": "{:%I:%M %p - %d/%b}",
    
	"tooltip": false
},

"clock#4": {
	"interval": 60,
    "format": "{:%B | %a %d, %Y | %I:%M %p}",
    
	"format-alt": "{:%a %b %d, %G}",
	"tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
},

"clock#5": {
    "format": "{:%A, %I:%M %P}",
    
	"format-alt": "{:%A, %d %B, %Y (%R)}",
	"tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
},

"cpu": {
	"format": "󰍛 {usage}%",
	"interval": 1,
	"min-length": 5,
	"states": {
		"warning": 70,
		"critical": 90
	},
	"format-icons": [
		"▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"
	],
	"on-click": "foot -e btop",
	"on-click-right": "foot -e btop",
	"tooltip": true,
	"tooltip-format": "CPU Usage: {usage}% | Load: {load} | Icon: {icon}"
},

"disk": {
	"interval": 30,
	
	"path": "/",
	
	"format": "{percentage_used}% 󰋊",
	
	"tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)"
},

"hyprland/language": {
	"format": "Lang: {}",
	"format-en": "US",
	"format-tr": "Korea",
	"keyboard-name": "at-translated-set-2-keyboard",
	"on-click": "hyprctl switchxkblayout $SET_KB next"
},

"hyprland/submap": {
	"format": "<span style=\"italic\">  {}</span>",
	"tooltip": false
},

"hyprland/window": {
	"format": "{}",
	"max-length": 55,
	"separate-outputs": true,
	"offscreen-css": true,
	"offscreen-css-text": "(inactive)",
	"rewrite": {
		"(.*) — Mozilla Firefox": " $1",
		"(.*) - fish": "> [$1]",
		"(.*) - zsh": "> [$1]",
		"(.*) - $term": "> [$1]"
	}
},

"idle_inhibitor": {
	"tooltip": true,
	"tooltip-format-activated": "Idle_inhibitor active",
	"tooltip-format-deactivated": "Idle_inhibitor not active",
	"format": "{icon}",
	"format-icons": {
		"activated": "♥",
		"deactivated": "♡"
	}
},


"memory": {
	"interval": 10,
	"format": "{percentage}% 󰾆",
	"tooltip": true,
	"tooltip-format": "Used: {used:0.1f}GB | Available: {avail:0.1f}GB | Total: {total:0.1f}GB ({percentage}%)",
	"on-click": "foot -e btop",
	"on-click-right": "foot -e btop"
},

"mpris": {
	"interval": 2,
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} <i>{dynamic}</i>",
	"format-stopped": "",
	"format-disconnected": "",
	"scroll-step": 5.0,
	"on-scroll-up": "$HOME/.local/share/openriot/install/openriot --volume inc",
	"on-scroll-down": "$HOME/.local/share/openriot/install/openriot --volume dec",
	"smooth-scrolling-threshold": 1,
	"tooltip": true,
	"tooltip-format": "{status_icon} {dynamic} (no playerctl on OpenBSD)",
	"player-icons": {
		"chromium": "",
		"default": "",
		"firefox": "",
		"kdeconnect": "",
		"mopidy": "",
		"mpv": "󰐹",
		"spotify": "",
		"vlc": "󰕼"
	},
	"status-icons": {
		"paused": "󰐎",
		"playing": "",
		"stopped": ""
	},
	
	"max-length": 40
},

"network": {
	"format": "󰤙",
	"tooltip": false,
	"interval": 86400,
	"on-click": "foot -e nmtui"
},

"network#speed": {
	"format": "",
	"interval": 86400
},

"power-profiles-daemon": {
  "format": "{icon} ",
  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
  "tooltip": true,
  "format-icons": {
    "default": "",
    "performance": "",
    "balanced": "",
    "power-saver": ""
  }
},

"pulseaudio": {
	"format": "{icon} {volume}%",
	"format-bluetooth": "{icon} 󰂰 {volume}%",
	"format-muted": "󰖁",
	"format-icons": {
		"headphone": "",
		"hands-free": "",
		"headset": "",
		"phone": "",
		"portable": "",
		"car": "",
		"default": [
			"󰕿", "󰖀", "󰕾", "󰕾"
		],
		"ignored-sinks": [
			"Easy Effects Sink"
		]
	},
	"scroll-step": 5.0,
	"on-click": "$HOME/.local/share/openriot/install/openriot --volume toggle",
	"on-click-right": "pavucontrol -t 3",
	"on-scroll-up": "$HOME/.local/share/openriot/install/openriot --volume inc",
	"on-scroll-down": "$HOME/.local/share/openriot/install/openriot --volume dec",
	"tooltip-format": "{icon} {desc} | {volume}%",
	"smooth-scrolling-threshold": 1
},

"pulseaudio#1": {
  "format": "{icon} {volume}%",
  "format-bluetooth": "{icon} {volume}%",
  "format-bluetooth-muted": " {icon}",
  "format-muted": "󰸈",
  "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
  "on-click": "pamixer --toggle-mute",
  "on-click-right": "pavucontrol -t 3",
  "tooltip": true,
  "tooltip-format": "{icon} {desc} | {volume}%"
},

"pulseaudio#microphone": {
	"format": "{format_source}",
	"format-source": " {volume}%",
	"format-source-muted": "",
	"on-click": "$HOME/.local/share/openriot/install/openriot --volume mic-toggle",
	"on-click-right": "pavucontrol -t 4",
	"on-scroll-up": "$HOME/.local/share/openriot/install/openriot --volume mic-inc",
	"on-scroll-down": "$HOME/.local/share/openriot/install/openriot --volume mic-dec",
	"tooltip-format": "{source_desc} | {source_volume}%",
	"scroll-step": 5
},

"tray": {
	"icon-size": 16,
	"spacing": 5,
	"show-passive-items": true
},

"wireplumber": {
	"format": "{icon} {volume} %",
	"format-muted": " Mute",
	"on-click": "$HOME/.local/share/openriot/install/openriot --volume toggle",
	"on-click-right": "pavucontrol -t 3",
	"on-scroll-up": "$HOME/.local/share/openriot/install/openriot --volume inc",
	"on-scroll-down": "$HOME/.local/share/openriot/install/openriot --volume dec",
	"format-icons": [
		"", "", "󰕾", ""
	]
},

"wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 20,
	"all-outputs": false,
	"tooltip-format": "{title}",
	"on-click": "activate",
	"on-click-middle": "close",
	"ignore-list": [
		"rofi",
		"fuzzel"
		],
	"icon-theme": "kora"
},

"sway/window": {
	"format": "{}",
	"max-length": 60,
	"rewrite": {
		"(.*) — Mozilla Firefox": " $1",
		"(.*) - fish": "> [$1]"
	}
},

"custom/openbsd": {
		"format": "󰀻",
		"on-click": "fuzzel",
		"on-click-right": "pkill fuzzel",
		"tooltip": true,
		"tooltip-format": "Left-click: App Launcher | Right-click: Close Launcher"
	},

    "custom/notifications": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 3,
    	"exec": "$HOME/.local/share/openriot/install/openriot --notify-waybar",
    	"on-click": "$HOME/.local/share/openriot/install/openriot --notify-dismiss",
    	"tooltip": true
    },


    "custom/openriot-update": {
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/openriot-update.sh",
    	"return-type": "json",
    	"interval": 300,
    	"on-click": "$HOME/.local/share/openriot/config/waybar/scripts/openriot-update.sh --click",
    	"tooltip": true
    },

    "custom/battery": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 30,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-battery.sh",
    	"on-click-right": "$HOME/.local/share/openriot/install/openriot --power-menu",
    	"tooltip": true
    },

    "custom/lock": {
    	"format": "󰌾",
    	"on-click": "swaylock -f",
    	"tooltip": true,
    	"tooltip-format": "󰷛 Screen Lock"
    },

    "custom/wlsunset": {
    	"format": "{}",
    	"exec": "$HOME/.local/share/openriot/install/openriot --wlsunset",
    	"signal": "SIGUSR1",
    	"on-click": "sh -c 'if pgrep -x wlsunset > /dev/null 2>&1; then pkill wlsunset; else wlsunset -t 3500; fi; kill -SIGUSR1 $(pgrep waybar)'",
    	"tooltip": true,
    	"tooltip-format": "󰆗 Warm Light (click to disable)",
    	"tooltip-format-alt": "󰛨 Normal Screen (click to enable)"
    },

    "custom/rec-dot": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 2,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/recording-indicator.sh",
    	"on-click": "$HOME/.local/share/openriot/config/waybar/scripts/recording-indicator.sh --click",
    	"tooltip": true
    },

    "custom/cpu-aggregate": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 2,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-cpu.sh",
    	"on-click": "foot -e htop",
    	"on-click-right": "foot -e htop",
    	"tooltip": true
    },

    "custom/power": {
    	"format": " ⏻ ",
    	"on-click": "$HOME/.local/share/openriot/install/openriot --power-menu",
    	"tooltip": false
    },

    "custom/temp-bar": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 10,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-temp.sh",
    	"on-click": "foot -e htop",
    	"on-click-right": "foot -e htop",
    	"tooltip": true
    },

    "custom/volume-bar": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 1,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-volume.sh",
    	"on-click": "$HOME/.local/share/openriot/install/openriot --volume toggle",
    	"on-scroll-up": "$HOME/.local/share/openriot/install/openriot --volume inc",
    	"on-scroll-down": "$HOME/.local/share/openriot/install/openriot --volume dec",
    	"tooltip": true
    },

    "custom/memory-accurate": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 5,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-memory.sh",
    	"on-click": "foot -e htop",
    	"on-click-right": "foot -e htop",
    	"tooltip": true
    },

    "custom/separator#dot": {
    	"format": "•",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#dot-line": {
    	"format": "",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#line": {
    	"format": "|",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#line-tray": {
    	"format": "|",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#blank": {
    	"format": "",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#blank_2": {
    	"format": "  ",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#blank_3": {
    	"format": "   ",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/separator#tight": {
    	"format": " ",
    	"interval": "once",
    	"tooltip": false
    },
    "custom/arrow1": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow2": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow3": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow4": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow5": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow6": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow7": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow8": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow9": {
    	"format": "",
    	"tooltip": false
    },

    "custom/arrow10": {
    	"format": "",
    	"tooltip": false
    },

    "custom/wireguard": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 300,
        "restart-interval": 60,
        "exec-if": "command -v wg && ifconfig >/dev/null 2>&1",
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/wireguard-status.sh",
    	"on-click": "$HOME/.local/share/openriot/config/waybar/scripts/wireguard-click.sh left",
    	"on-click-right": "$HOME/.local/share/openriot/config/waybar/scripts/wireguard-click.sh right",
    	"tooltip": true
    },
    "custom/weather-emoji": {
    	"format": "{}",
    	"interval": 600,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/weather-emoji-plain.sh",
    	"tooltip": true
    },

    "custom/network": {
    	"format": "{}",
    	"return-type": "json",
    	"interval": 300,
    	"exec": "$HOME/.local/share/openriot/config/waybar/scripts/waybar-network",
    	"on-click": "$HOME/.local/share/openriot/config/waybar/scripts/wifi-selector.sh",
    	"tooltip": true
    },

"group/mobo_drawer": {
        "drawer": {
            "transition-left-to-right": true,
            "transition-duration": 500,
            "children-class": "cpu"
        },
        "orientation": "inherit",
        "modules": [
            "temperature",
            "cpu",
            "power-profiles-daemon",
            "memory",
            "disk"
        ]
    },
    "group/system-metrics": {
        "orientation": "inherit",
        "modules": [
            "custom/temp-bar",
            "custom/cpu-aggregate",
            "custom/memory-accurate"
        ]
    },
    "group/status": {
        "orientation": "inherit",
        "modules": [
            "custom/power"
        ]
    },
    "group/laptop": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "battery"
        ]
    },
    "group/app_drawer": {
        "drawer": {
            "transition-left-to-right": true,
            "transition-duration": 500,
            "children-class": "custom/menu"
        },
        "orientation": "inherit",
        "modules": [
            "custom/menu",
            "custom/light_dark",
            "custom/file_manager",
            "custom/tty",
            "custom/browser",
            "custom/settings"
        ]
    },
    "group/app_icons": {
        "orientation": "horizontal",
        "modules": [
            "custom/menu",
            "custom/light_dark",
            "custom/file_manager",
            "custom/tty",
            "custom/browser",
            "custom/settings"
        ]
    },
    "group/notify": {
        "drawer": {
            "transition-left-to-right": false,
            "transition-duration": 500,
            "children-class": "custom/notifications"
        },
        "orientation": "inherit",
        "modules": [
        ]
    },
    "group/motherboard": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "power-profiles-daemon",
            "memory",
            "temperature",
            "disk"
        ]
    },
    "group/connections": {
        "drawer": {
            "transition-left-to-right": true,
            "transition-duration": 500,
            "children-class": "bluetooth"
        },
        "orientation": "inherit",
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "group/power#vert": {
        "drawer": {
            "transition-left-to-right": false,
            "transition-duration": 300,
            "children-class": "not-memory"
        },
        "orientation": "inherit",
        "modules": [
            "custom/lock",
            "custom/power",
            "custom/logout",
            "custom/reboot"
        ]
    },
    "group/audio": {
        "drawer": {
            "transition-left-to-right": true,
            "transition-duration": 500,
            "children-class": "pulseaudio"
        },
        "orientation": "inherit",
        "modules": [
            "pulseaudio",
            "pulseaudio#microphone"
        ]
    },
    "group/power": {
        "drawer": {
            "transition-left-to-right": false,
            "transition-duration": 500,
            "children-class": "drawer-child"
        },
        "orientation": "inherit",
        "modules": [
            "custom/lock",
            "custom/power",
            "custom/quit",
            "custom/reboot"
        ]
    },

"sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "swaymsg workspace back-and-forth",
    "on-scroll-up": "swaymsg workspace next_on_output",
    "on-scroll-down": "swaymsg workspace prev_on_output",

    "format": "{icon}{windows}",
    "format-format-separator": " ",
    "window-rewrite-delay": 200,

    "format-icons": {
      "focused": "<span font='14'></span>",
      "default": "<span font='14'>◉</span>",
      "empty": "<span font='14'>○</span>"
    },

