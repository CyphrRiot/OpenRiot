/* OpenRiot Waybar Configuration */
/* OpenBSD / Sway — CypherRiot Aesthetic */

[
    {
        "include": [
            "$HOME/.config/waybar/Modules",
            "$HOME/.config/waybar/ModulesCustom",
            "$HOME/.config/waybar/ModulesGroups",
            "$HOME/.config/waybar/ModulesWorkspaces",
            "$HOME/.config/waybar/UserModules",
            "$HOME/.config/waybar/UserWorkspaces"
        ],

        "fixed-center": true,
        "layer": "top",
        "margin-right": 8,
        "margin-left": 8,
        "spacing": 10,
        "passthrough": false,
        "exclusive": true,
        "margin-top": 3,
        "position": "top",
        "ipc": false,

        "modules-left": [
            "custom/openbsd",
            "custom/separator#blank",
            "sway/workspaces",
            "custom/separator#blank",
            "sway/window"
        ],

        "modules-center": [
            "clock",
            "custom/separator#dot",
            "custom/weather-emoji",
            "custom/notifications"
        ],

        "modules-right": [
            "custom/separator#blank_3",
            "custom/rec-dot",
            "tray",
            "custom/separator#blank",
            "group/system-metrics",
            "custom/separator#blank",
            "custom/volume-bar",
            "custom/separator#blank",
            "custom/network",
            "custom/wireguard",
            "custom/separator#blank",
            "custom/battery",
            "custom/separator#blank",
            "custom/openriot-update",
            "custom/separator#blank",
            "custom/power",
            "custom/lock"
        ]
    }
]
