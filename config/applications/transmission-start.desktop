[Desktop Entry]
Version=1.0
Name=Transmission (Start)
GenericName=BitTorrent Daemon
Comment=Start Transmission BitTorrent daemon
Icon=network-peer
Exec=sh -c "mkdir -p ~/.local/share/transmission ~/.config/transmission && transmission-daemon -f --logfile ~/.local/share/transmission/daemon.log &"
Terminal=false
Type=Application
Categories=Network;FileTransfer;
Keywords=torrent;download;transmission;
