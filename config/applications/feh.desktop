[Desktop Entry]
Name=Feh Image Viewer
GenericName=Image Viewer
Comment=View images scaled to screen
Icon=image-viewer
Exec=feh --scale-down --auto-zoom --start-at %u
Terminal=false
Type=Application
Categories=Graphics;Viewer;
Keywords=image;photo;picture;viewer;
StartupNotify=false
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/png;image/tiff;image/webp;image/x-icon;image/x-pixmap;image/svg+xml;image/heic;image/heif;