# OpenRiot Sway Config — OpenBSD

# Modifier key — Mod1=Alt (Mod4=Super may not work on all keyboards)
set $mod Mod1

# Variables
set $terminal havoc
set $fileManager havoc lf
set $browser firefox
set $editor hx
set $menu fuzzel

# Appearance
font pango:JetBrainsMono NF 11
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
smart_gaps on
smart_borders on

# Border colors (blue theme)
client.focused           #4c7899 #285577 #ffffff
client.focused_inactive  #333333 #333333 #ffffff
client.unfocused         #333333 #333333 #888888
client.urgent            #d12121 #880000 #ffffff

# Input — keyboard
input type:keyboard {
    xkb_layout us
}

# Input — mouse
input type:pointer {
    accel_profile flat
    pointer_accel 0.0
}

# Cursor
seat seat0 xcursor_theme Bibata-Modern-Ice 28

# Monitor — comment out to allow auto-detection via swaymsg
# Run `swaymsg -t get_outputs` to find your monitor name
# output HDMI-A-1 {
#     mode 1920x1080@60Hz
#     scale 1
#     pos 0 0
# }

# Autostart
exec waybar
exec swaybg -i "$HOME/.local/share/openriot/backgrounds/riot_00.jpg" -m fill
exec swayidle -w timeout 300 'bash $HOME/.local/share/openriot/config/bin/openriot-lock.sh && swaylock -i /tmp/swaylock-bg.png -f' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
exec_always autotiling

# Focus
focus_follows_mouse no
workspace_auto_back_and_forth yes

# Drag floating windows with mouse (hold $mod + left click)
floating_modifier $mod normal

# Include keybindings and window rules
include ~/.config/sway/keybindings.conf
include ~/.config/sway/windowrules.conf
