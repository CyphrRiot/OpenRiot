# OpenRiot Sway Config — OpenBSD

# Modifier key — Mod4=Super (Windows key), Mod1=Alt
# On OpenBSD, use Mod1 if Windows key isn't detected as Mod4
set $mod Mod1

# Variables
set $terminal havoc
set $fileManager havoc lf
set $browser firefox
set $editor hx
set $menu fuzzel

# Appearance
font pango:JetBrainsMono NF 11
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart

# Input — keyboard
input type:keyboard {
    xkb_layout us
    xkb_options ctrl:nocaps,alt:Super
    repeat_delay 180
    repeat_rate 55
}

# Input — mouse
input type:pointer {
    accel_profile flat
    pointer_accel 0.0
}

# Cursor
seat seat0 xcursor_theme Bibata-Modern-Ice 28

# Monitor — HDMI-A-1 at 1920x1080
output HDMI-A-1 {
    mode 1920x1080@60Hz
    scale 1
    pos 0 0
}

# Autostart
exec waybar
exec swaybg -i "$HOME/.local/share/openriot/backgrounds/riot_00.jpg" -m fill

# Focus
focus_follows_mouse no

# Include keybindings and window rules
include ~/.config/sway/keybindings.conf
include ~/.config/sway/windowrules.conf
