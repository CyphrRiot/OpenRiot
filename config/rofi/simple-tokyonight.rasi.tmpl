* {
  font:   "FiraCode Nerd Font Medium 14";

  bg0     : {{.BaseBG}};
  bg1     : {{.BaseBG}};
  bg2     : {{.BaseBG2}};
  bg3     : {{.ExtendedMuted}};
  fg0     : {{.BaseFG}};
  fg1     : {{.BaseFG2}};
  fg2     : {{.BaseFG3}};
  red     : {{.SemanticError}};
  green   : {{.AccentFG}};
  yellow  : {{.SemanticWarning}};
  blue    : {{.SemanticInfo}};
  magenta : {{.ExtendedViolet}};
  cyan    : {{.SemanticCyan}};

  accent: @green;
  urgent: @yellow;

  background-color : transparent;
  text-color       : @fg0;

  margin  : 0;
  padding : 0;
  spacing : 0;
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

window {
  anchor : center;
  location : center;
  width : 280px;

  background-color: @bg1;
  border: 1px;
  border-color: @accent;
  border-radius: 6px;
}

inputbar {
  spacing  : 8px;
  padding  : 4px 8px;
  children : [ icon-search, entry ];

  background-color: @bg0;
}

icon-search, entry, element-icon, element-text {
  vertical-align: 0.5;
}

icon-search {
  expand   : false;
  filename : "search-symbolic";
  size     : 14px;
}

textbox {
  padding          : 4px 8px;
  background-color : @bg2;
}

listview {
  padding      : 4px 0px;
  lines        : 30;
  columns      : 1;
  scrollbar    : true;
  fixed-height : false;
  dynamic      : true;
}

element {
  padding : 4px 8px;
  spacing : 8px;
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected {
  text-color       : @bg1;
  background-color : @accent;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 0.8em;
}

element-text {
  text-color: inherit;
}

scrollbar {
  handle-width : 4px;
  handle-color : @fg2;
  padding      : 0 4px;
}
