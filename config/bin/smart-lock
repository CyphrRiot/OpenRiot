#!/bin/sh
#
# smart-lock - Lock screen only when no media is playing
# Prevents locking while watching YouTube, listening to music, etc.

# Check if any audio is playing (PulseAudio)
if command -v pactl >/dev/null 2>&1; then
    if pactl list sink-inputs 2>/dev/null | grep -q "State: RUNNING"; then
        exit 0
    fi
fi

# Check for known media players
for player in firefox mpv vlc mplayer chrome chromium; do
    if pgrep -x "$player" >/dev/null 2>&1; then
        exit 0
    fi
done

# No media detected - lock the screen
exec ~/.local/share/openriot/install/openriot --lock
