#!/bin/sh

# OpenRiot - OpenBSD WiFi Manager
# Adapted from https://github.com/D5Nch3ck/wifi-menu

RED="\033[0;031m"
BLU="\033[1;34m"
YLW="\033[1;33m"
RST="\033[1;0m"
GRN="\033[32m"

INT=${1:-$(ifconfig | awk '/^[a-z]/ { iface=$1 } /ieee80211/ { print iface; exit }' | tr -d ':')}
WIFI_DIR="/etc/wifi_saved"

if [ -z "$INT" ]; then
    echo "[!] No wireless interface found"
    exit 1
fi

# Strip any trailing colon from interface name
INT=$(printf '%s' "$INT" | tr -d ':')

read_saved() {
    /sbin/ifconfig $INT -inet6 -inet -bssid -chan -nwid -nwkey -wpa -wpakey

    SAVED_LIST=$(ls -h $WIFI_DIR 2>/dev/null)
    if [ -z "${SAVED_LIST}" ]; then
        echo "[!] No saved wifi connections"
        conf_create
    fi

    i=1
    for j in ${SAVED_LIST}; do
        echo "$i) $j"
        file[i]=$j
        i=$(( i + 1 ))
    done | column -s '\n' | sed 's@\\|$@\\)\\)@g';echo

    echo -ne "[+] Choose saved connection or Enter to skip: "
    read v_CHOOSELIST

    if [ -z "${file[$v_CHOOSELIST]}" ]; then
        conf_create
    fi

    saved_connect "${file[$v_CHOOSELIST]}"
}

conf_create() {
    /sbin/ifconfig $INT up
    /usr/bin/pkill dhclient 2>/dev/null
    LIST=$(/sbin/ifconfig $INT scan 2>/dev/null | sed -ne 's/^.*nwid \(.*\) chan .*$/\1/p')

    if [ -z "$LIST" ]; then
        echo "[!] No available wifi networks on $INT"
        exit 1
    fi

    i=1
    for j in $LIST; do
        echo "$i) $j"
        list[i]=$j
        i=$(( i + 1 ))
    done | column -s '\n' | sed 's@\\|$@\\)\\)@g';echo

    echo -ne "[+] Choose network or Enter to quit: "
    read i_CHOOSELIST

    if [ -z "${list[$i_CHOOSELIST]}" ]; then
        exit 1
    fi

    echo -ne "[+] Passphrase for \"${list[$i_CHOOSELIST]}\": "
    stty -echo
    read PASSWORD
    stty echo
    echo

    if [ ${#PASSWORD} -lt 8 ]; then
        echo "[!] Passphrase must be 8-63 characters"
        exit 1
    fi

    connect "${list[$i_CHOOSELIST]}" "$PASSWORD"
}

saved_connect() {
    echo "[+] Connecting using $1"
    /sbin/ifconfig $INT up
    /usr/bin/pkill dhclient 2>/dev/null
    /sbin/ifconfig $INT nwid "$(grep nwid "$WIFI_DIR/$1" | tail -1 | cut -d\" -f2)" \
        wpakey "$(grep wpakey "$WIFI_DIR/$1" | tail -1 | cut -d\" -f2)"
    /bin/cp "$WIFI_DIR/$1" /etc/hostname.$INT
    echo "[+] Connected to \"$1\""
    /sbin/dhclient $INT
    exit
}

connect() {
    ESSID=$1
    PASS=$2
    echo "[+] Connecting to \"$ESSID\""
    /sbin/ifconfig $INT up
    /usr/bin/pkill dhclient 2>/dev/null
    /sbin/ifconfig $INT nwid "$ESSID" wpakey "$PASS"
    echo "[+] Running dhclient"
    /sbin/dhclient $INT
    exit
}

echo " OpenBSD WiFi Manager"
echo " Interface: $INT"
echo ""
read_saved
