# OpenRiot i3 Config — OpenBSD X11

set $mod Mod4
set $openriot_bin $HOME/.local/share/openriot/install/openriot
set $terminal alacritty
set $fileManager thunar
set $browser $HOME/.local/share/openriot/install/openriot --browser
set $editor gnome-text-editor

font pango:FiraCode Nerd Font 11
default_border pixel 1
default_floating_border pixel 1
default_orientation horizontal
hide_edge_borders none
smart_gaps off
gaps inner 0
gaps outer 0
gaps top 28

# Force border on GTK CSD apps
for_window [class="gnome-text-editor"] border pixel 2
for_window [class="^(libreoffice|LibreOffice)$"] border pixel 1

# Kill OpenBSD xconsole window on login
for_window [class="^XConsole$"] kill
for_window [class="^xconsole$"] kill

# Colors
client.focused           #37a29c #285577 #ffffff #50c9c3 #37a29c
client.focused_inactive  #333333 #333333 #ffffff
client.unfocused         #333333 #333333 #888888
client.urgent            #d12121 #880000 #ffffff
client.background        #1a1b26

# Include user-specific overrides
include keybindings.conf

# =============================================================================
# AUTOSTART
# =============================================================================

# Status bar - generate scaled config, wait for i3 IPC readiness, then launch polybar
exec --no-startup-id $openriot_bin --polybar-setup
exec --no-startup-id sh -c 'while ! i3-msg -t get_version >/dev/null 2>&1; do sleep 1; done; sleep 2; $openriot_bin --notify info "Polybar" "Starting Polybar..." normal 5000'
exec_always --no-startup-id sh -c 'sleep 2; pgrep -f "^polybar left$" >/dev/null || polybar left'
exec_always --no-startup-id sh -c 'sleep 2; pgrep -f "^polybar center$" >/dev/null || polybar center'
exec_always --no-startup-id sh -c 'sleep 2; pgrep -f "^polybar right$" >/dev/null || polybar right'
# Defensive: if a polybar section crashes, restart it quickly
exec_always --no-startup-id sh -c 'lock=/tmp/openriot-polybar-watchdog.pid; [ -f "$lock" ] && kill -0 "$(cat "$lock")" 2>/dev/null && exit 0; echo $$ > "$lock"; trap "rm -f $lock" EXIT; sleep 10; while true; do for b in left center right; do pgrep -f "^polybar $b$" >/dev/null || { nohup polybar $b >/dev/null 2>&1 & }; done; sleep 5; done'

# Wallpaper
exec --no-startup-id $openriot_bin --wallpaper-load

# Compositor - runs picom synchronously; loop restarts it if it crashes
exec --no-startup-id sh -c 'while true; do pgrep picom >/dev/null || picom --config $HOME/.local/share/openriot/config/picom.conf; sleep 5; done'

# WireGuard VPN - auto-start if enabled (after network is up)
exec --no-startup-id sh -c 'sleep 3; $openriot_bin --wireguard-autostart'

# Restore saved volume level from previous session
exec --no-startup-id sh -c 'sleep 2; $openriot_bin --volume restore'

# Restore saved monitor resolution from previous session
exec --no-startup-id sh -c 'sleep 2; $openriot_bin --resolution-restore'

# Restore window layout from previous session
exec --no-startup-id sh -c 'sleep 3; $openriot_bin --window-restore'

# Restore night light state from previous session
exec --no-startup-id sh -c 'sleep 4; $openriot_bin --night-light-restore'

# Notifications - watchdog starts dunst on first notification
exec --no-startup-id sh -c 'while true; do if ! dunstctl count displayed >/dev/null 2>&1; then pkill dunst 2>/dev/null || true; i=0; while [ $i -lt 20 ] && pgrep dunst >/dev/null; do sleep 0.1; i=$((i+1)); done; nohup /usr/local/bin/dunst >/dev/null 2>&1 & fi; sleep 5; done'

# Clipboard manager - disabled: confirmed X selection polling causes keyboard input loss in Alacritty
# exec --no-startup-id clipmenud

# Auto-tiling
# exec_always --no-startup-id i3-auto-layout

# GTK/XFCE settings daemon
# DISABLED - was overriding screen saver/DPMS settings causing 10-min timeout
# exec --no-startup-id xfsettingsd

# XFCE config daemon (needed for xfce4-settings-manager)
exec --no-startup-id /usr/local/lib/xfce4/xfconf/xfconfd

# Music Player Daemon (MPD) - keeps library indexed for rmpc
exec --no-startup-id sh -c 'sleep 3; while true; do pgrep mpd >/dev/null || mpd ~/.mpd/mpd.conf 2>/dev/null; sleep 5; done'

# =============================================================================
# BEHAVIOR
# =============================================================================

focus_follows_mouse no
workspace_auto_back_and_forth no
floating_modifier Mod4

# =============================================================================
# WINDOW RULES
# =============================================================================

# Floating terminal
for_window [class="^URxvt$" instance="^floating"] floating enable, resize set 900 600, move position center

# Centered floating terminal (Super+Shift+Enter)
for_window [instance="^floating_center"] floating enable
for_window [instance="^floating_center"] resize set 40 ppt 60 ppt
for_window [instance="^floating_center"] move position center

# Transmission
for_window [class="^Transmission$"] floating enable, resize set 800 600, move position center

# OpenRiot dialogs
for_window [class="^(openriot_upgrade|OpenRiot Update Available|Proton Sync Update)$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [class="^openriot_wifi$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [class="^openriot_disk$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [class="^openriot_migrate$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [class="^openriot_resolution$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [class="^glyphriot$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [class="^zcash-mini$"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [title="^(OpenRiot Control Center)$"] floating enable, resize set 480 340, move position center

# Popups
for_window [class="^(xdg-desktop-portal-gtk)$" title="^(Save a File)$"] floating enable

