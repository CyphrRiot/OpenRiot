# OpenRiot Dunst Configuration
# X11 Notification Daemon

[global]
    monitor = 0
    follow = mouse
    width = 495
    height = (0, 330)
    origin = center
    offset = (0, 0)
    scale = 0
    notification_limit = 10
    progress_bar = false
    progress_bar_height = 10
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = true
    shrink = false
    separator_height = 2
    padding = 18
    horizontal_padding = 18
    frame_width = 2
    frame_color = "#9ECE6A"
    sort = no
    font = FiraCode Nerd Font 12
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = false
    ignore_newline = false
    stack_duplicates = true
    hide_duplicate_count = false
    sticky_history = true
    history_length = 20
    corner_radius = 7
    close = ctrl+space
    history = ctrl+grave

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#565F89"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#9ECE6A"
    timeout = 2

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#F7768E"
    timeout = 5
