# OpenRiot Dunst Configuration
# X11 Notification Daemon

[global]
    monitor = 0
    follow = mouse
    width = 450
    height = (0, 200)
    offset = (16, 42)
    scale = 0
    notification_limit = 10
    progress_bar = false
    progress_bar_height = 10
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = true
    shrink = false
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#7aa2f7"
    sort = no
    font = FiraCode Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = false
    ignore_newline = false
    stack_duplicates = true
    hide_duplicate_count = false
    sticky_history = true
    history_length = 20
    corner_radius = 8
    close = ctrl+space
    history = ctrl+grave

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 2

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#6600cc"
    timeout = 5
