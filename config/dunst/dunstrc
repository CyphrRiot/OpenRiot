# OpenRiot Dunst Configuration
# X11 Notification Daemon

[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    offset = (16, 42)
    scale = 0
    notification_limit = 10
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame = true
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = true
    shrink = false
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#7aa2f7"
    sort = no
    font = FiraCode Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = false
    ellipse_size = 50
    ignore_newline = false
    stack_duplicates = true
    hide_duplicate_count = false
    show_transients = true
    urgent = server
    normalize = true
    geometry = 
    transparency = 0
    notification_depth = 3
    sticky_history = true
    history_length = 20
    always_run_script = true
    script_dir = ~/.local/share/openriot/config/dunst/scripts
    default_icon = dialog-information
    corner_radius = 8
    ignore_dbusnext = false

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 10

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0

[shortcut]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[script]
    openriot_update = openriot-update.sh
