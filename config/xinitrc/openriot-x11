#!/bin/sh
# OpenRiot X11 startup
# Run with: xinit ~/.xinitrc

# Add user and openriot binaries to PATH
export PATH="$HOME/.local/bin:$HOME/.local/share/openriot/install:$PATH"

# XDG_RUNTIME_DIR — required by Qt/Wayland apps, must be 0700
export XDG_RUNTIME_DIR=/tmp/$USER-runtime
mkdir -p $XDG_RUNTIME_DIR
chmod 0700 $XDG_RUNTIME_DIR

# Set cursor theme
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# Force GTK apps to use dark theme
export GTK_THEME=Adwaita-dark

# Refresh font/cursor cache
fc-cache -f 2>/dev/null

# Load Xresources
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Kill xconsole (annoying full-screen console on OpenBSD login)
pkill -f xconsole 2>/dev/null || true

# Screensaver at 10 min, monitor off at 30 min
xset s off
xset -dpms
xset dpms 0 0 1800
xset +dpms
xautolock -time 10 -locker "$HOME/.local/share/openriot/install/openriot --smart-lock" &

# # Configure trackpad pointer speed (lower = slower)
# doas wsconsctl mouse.tp.scaling=0.8 2>/dev/null || true

# Start i3 (or fallback)
exec i3
