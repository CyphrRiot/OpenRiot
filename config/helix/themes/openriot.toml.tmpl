# OpenRiot Helix Theme
# Built on term16_dark with palette overridden from colors.toml
inherits = "term16_dark"

[palette]
black       = "{{.BaseBG}}"
red         = "{{.SemanticError}}"
green       = "{{.AccentFG}}"
yellow      = "{{.SemanticWarning}}"
blue        = "{{.SemanticInfo}}"
magenta     = "{{.ExtendedPurple}}"
cyan        = "{{.SemanticCyan}}"
white       = "{{.BaseFG}}"
gray        = "{{.BaseFG3}}"
light-red   = "{{.SemanticError}}"
light-green = "{{.AccentFGLight}}"
light-yellow = "{{.SemanticWarning}}"
light-blue  = "{{.ExtendedSky}}"
light-magenta = "{{.ExtendedViolet}}"
light-cyan  = "{{.ExtendedCyanDim}}"
light-gray  = "{{.BaseFG2}}"
