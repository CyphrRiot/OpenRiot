; OpenRiot Polybar Config — Tokyo Night Theme for OpenBSD X11

[colors]
bg = {{.ExtendedBGDark}}
alpha-bg = {{.ExtendedAlphaBG}}
bg2 = {{.ExtendedBGMid}}
fg = {{.ExtendedFGBright}}
fg2 = {{.BaseFG2}}
fg3 = {{.BaseFG3}}
red = {{.SemanticError}}
orange = {{.ExtendedOrange}}
yellow = {{.SemanticWarning}}
green = {{.AccentFG}}
cyan = {{.SemanticCyan}}
blue = {{.SemanticInfo}}
sky = {{.ExtendedSky}}
electric = {{.ExtendedElectric}}
purple = {{.ExtendedPurple}}
violet = {{.ExtendedViolet}}
teal = {{.ExtendedTeal}}
intermediate = {{.ExtendedElectric}}
cyan-dim = {{.ExtendedCyanDim}}
muted = {{.ExtendedMuted}}

[global/wm]
margin-bottom = 3

[bar/main]
type = xcb
enable-ipc = true
fixed-center = false
width = 100%
height = 26
radius = 0
underline-size = 0
underline-color = ${colors.cyan}
line-size = 0
dpi-x = 96
dpi-y = 96
offset-y = 3
padding-right = 1
padding-left = 1
module-margin = 1
spacing = 0
clickareas = 64


; Fonts
font-0 = "Hurmit Nerd Font:size=11"
font-1 = "Hurmit Nerd Font:size=18"
font-2 = "Hurmit Nerd Font:size=12"

; Separator style
separator = ""
separator-padding = 0

; Modules layout: i3 workspaces | arrow | date | arrow | volume | network | battery | arrow | power
modules-left = launcher all
modules-center = weather date
modules-right = crypto proton-drive night-light sep transmission nzbget cpu memory sep wireguard stealth network-wifi network-eth openriot-update sep hdmi volume battery sep screenrec settings power lock

; Colors
background = ${colors.alpha-bg}
foreground = ${colors.fg}
line-color = ${colors.cyan}

; ========================
; MODULES
; ========================


[module/all]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-all
interval = 4
tail = false
format = <label>
format-foreground = ${colors.fg}
format-padding = 0
label = %output%

[module/launcher]
type = custom/text
format = "%{T2}%{T-}"
format-foreground = {{.ExtendedLauncherFG}}

format-padding = 0
click-left = $HOME/.local/share/openriot/install/openriot --rofi

[module/sep]
type = custom/text
format = "·"
content-foreground = {{.ExtendedSepBG}}

[module/date]
type = internal/date
interval = 60
format = <label>
format-foreground = ${colors.fg2}
format-offset = 0
format-padding = 0
date = "%A • %B %d • %I:%M %p"
label = %date%
click-left = $HOME/.local/share/openriot/install/openriot --wallpaper-next

[module/volume]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-volume
exec-click = true
interval = 29
tail = false
format = <label>
format-foreground = ${colors.cyan}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --volume toggle
scroll-up = $HOME/.local/share/openriot/install/openriot --volume inc
scroll-down = $HOME/.local/share/openriot/install/openriot --volume dec

[module/network-wifi]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --network-wifi
interval = 60
tail = false
format = <label>
format-foreground = ${colors.sky}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --wifi-click

[module/network-eth]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --network-eth
interval = 37
tail = false
format = <label>
format-foreground = ${colors.sky}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --eth-info

[module/battery]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --battery
interval = 34
tail = false
format = <label>
format-foreground = ${colors.cyan}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --battery-notify

[module/settings]
type = custom/text
format = "%{T1}%{T-}%{O2}"
format-foreground = ${colors.cyan-dim}

format-padding = 0
click-left = $HOME/.local/share/openriot/install/openriot --settings-menu

[module/openriot-update]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --update-status
interval = 14400
tail = false
format = <label>
format-foreground = ${colors.sky}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --update

[module/hdmi]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --hdmi
interval = 65
tail = false
format = <label>
format-foreground = ${colors.cyan}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --hdmi-toggle

[module/weather]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --weather
interval = 1800
tail = false
format = <label>
format-foreground = ${colors.fg3}
format-offset = 0
format-padding = 0
label = %output%
label-empty =

[module/proton-drive]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-proton-drive
interval = 60
tail = false
format = <label>
format-foreground = ${colors.teal}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --proton-drive-sync

[module/transmission]
