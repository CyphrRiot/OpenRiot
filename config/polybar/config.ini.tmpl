; OpenRiot Polybar Config — Tokyo Night Theme for OpenBSD X11

[colors]
bg = {{.ExtendedBGDark}}
alpha-bg = {{.ExtendedAlphaBG}}
bar-left = #9906070B
bar-center = #3306070B
bar-right = #9906070B
bg2 = {{.ExtendedBGMid}}
fg = {{.ExtendedFGBright}}
fg2 = {{.BaseFG2}}
fg3 = {{.BaseFG3}}
red = {{.SemanticError}}
orange = {{.ExtendedOrange}}
yellow = {{.SemanticWarning}}
green = {{.AccentFG}}
cyan = {{.SemanticCyan}}
blue = {{.SemanticInfo}}
sky = {{.ExtendedSky}}
electric = {{.ExtendedElectric}}
purple = {{.ExtendedPurple}}
violet = {{.ExtendedViolet}}
teal = {{.ExtendedTeal}}
intermediate = {{.ExtendedElectric}}
cyan-dim = {{.ExtendedCyanDim}}
muted = {{.ExtendedMuted}}

[global/wm]
margin-bottom = 1

[bar/left]
type = xcb
override-redirect = true
enable-struts = false
screenchange-reload = true
enable-ipc = true
fixed-center = false
width = 38%
height = 26
radius = 12
underline-size = 0
underline-color = ${colors.cyan}
line-size = 0
dpi-x = 96
dpi-y = 96
offset-x = 0.5%
offset-y = 0
padding-right = 2
padding-left = 0
module-margin = 1
spacing = 0
clickareas = 64
cursor-click = default
cursor-scroll = default

font-0 = "Hurmit Nerd Font:size=11;2"
font-1 = "Hurmit Nerd Font:size=11;2"
font-2 = "Hurmit Nerd Font:size=12;2"

separator = ""
separator-padding = 0

modules-left = all
modules-center =
modules-right =

background = ${colors.bar-left}
foreground = ${colors.fg}
line-color = ${colors.cyan}

[bar/center]
type = xcb
override-redirect = true
enable-struts = false
screenchange-reload = true
enable-ipc = true
fixed-center = true
width = 21%
height = 26
radius = 12
underline-size = 0
underline-color = ${colors.cyan}
line-size = 0
dpi-x = 96
dpi-y = 96
offset-x = 40%
offset-y = 0
padding-right = 2
padding-left = 2
module-margin = 1
spacing = 0
clickareas = 64
cursor-click = default
cursor-scroll = default

font-0 = "Hurmit Nerd Font:size=11;4"
font-1 = "Hurmit Nerd Font:size=11;4"
font-2 = "Hurmit Nerd Font:size=12;4"

separator = ""
separator-padding = 0

modules-left =
modules-center = weather date
modules-right =

background = ${colors.bar-center}
foreground = ${colors.fg}
line-color = ${colors.cyan}

[bar/right]
type = xcb
override-redirect = true
enable-struts = false
screenchange-reload = true
enable-ipc = true
fixed-center = true
width = 37%
height = 26
radius = 12
underline-size = 0
underline-color = ${colors.cyan}
line-size = 0
dpi-x = 96
dpi-y = 96
offset-x = 62.5%
offset-y = 0
padding-right = 2
padding-left = 2
module-margin = 1
spacing = 0
clickareas = 64
cursor-click = default
cursor-scroll = default

font-0 = "Hurmit Nerd Font:size=11;2"
font-1 = "Hurmit Nerd Font:size=11;2"
font-2 = "Hurmit Nerd Font:size=12;2"

separator = ""
separator-padding = 0

modules-left =
modules-center =
modules-right = crypto proton-drive night-light sep transmission nzbget cpu memory sep wireguard stealth network-wifi network-eth openriot-update sep hdmi volume battery sep control-panel settings power

background = ${colors.bar-right}
foreground = ${colors.fg}
line-color = ${colors.cyan}

; ========================
; MODULES
; ========================


[module/all]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-all
interval = 4
tail = false
format = <label>
format-foreground = ${colors.fg}
format-padding = 1
label = %output%

[module/launcher]
type = custom/text
format = "%{T2}"
format-foreground = ${colors.cyan}

format-padding = 0
click-left = $HOME/.local/share/openriot/install/openriot --rofi

[module/sep]
type = custom/text
format = "·"
format-foreground = {{.ExtendedSepBG}}

[module/date]
type = internal/date
interval = 60
format = <label>
format-foreground = ${colors.fg}
format-offset = 0
format-padding = 0
date = "%A · %B %d · %I:%M %p"
label = %date%
click-left = $HOME/.local/share/openriot/install/openriot --wallpaper-next

[module/volume]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-volume
exec-click = true
interval = 29
tail = false
format = <label>
format-foreground = ${colors.green}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --volume toggle
scroll-up = $HOME/.local/share/openriot/install/openriot --volume inc
scroll-down = $HOME/.local/share/openriot/install/openriot --volume dec

[module/network-wifi]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --network-wifi
interval = 60
tail = false
format = <label>
format-foreground = ${colors.cyan}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --wifi-click

[module/network-eth]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --network-eth
interval = 37
tail = false
format = <label>
format-foreground = ${colors.cyan-dim}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --eth-info

[module/battery]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --battery
interval = 34
tail = false
format = <label>
format-foreground = ${colors.green}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --battery-notify

[module/settings]
type = custom/text
format = "%{O2}"
format-foreground = ${colors.cyan}

format-padding = 0
click-left = $HOME/.local/share/openriot/install/openriot --settings-dropdown

[module/control-panel]
type = custom/text
format = "󰐰%{O2}"
format-foreground = ${colors.violet}

format-padding = 0
click-left = alacritty --title "OpenRiot Control Center" --class openriot_control -e openriot --control-center

[module/openriot-update]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --update-status
interval = 14400
tail = false
format = <label>
format-foreground = ${colors.violet}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --update

[module/hdmi]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --hdmi
interval = 65
tail = false
format = <label>
format-foreground = ${colors.sky}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --hdmi-toggle

[module/weather]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --weather
interval = 1800
tail = false
format = <label>
format-foreground = ${colors.sky}
format-offset = 0
format-padding = 0
label = %output%
label-empty =

[module/proton-drive]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-proton-drive
interval = 60
tail = false
format = <label>
format-foreground = ${colors.sky}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --proton-drive-sync

[module/transmission]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-transmission
interval = 60
tail = false
format = <label>
format-foreground = ${colors.teal}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --transmission-notify

[module/crypto]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --crypto-icon
interval = 60
format = <label>
format-foreground = ${colors.cyan}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --crypto-notify

[module/nzbget]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-nzbget
interval = 26
tail = false
format = <label>
format-foreground = ${colors.red}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --nzbget-open

[module/night-light]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --night-light-status
interval = 60
tail = false
format = <label>
format-foreground = ${colors.orange}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --night-light

[module/screenrec]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --screenrec-status
interval = 7
tail = false
format = <label>
format-foreground = ${colors.red}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --screenrec-toggle

[module/wireguard]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --wireguard-status
interval = 60
tail = false
format = <label>
format-foreground = ${colors.electric}

format-padding = 0
label = %output%
label-empty =
click-left = $HOME/.local/share/openriot/install/openriot --wireguard-notify

[module/stealth]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --stealth-status
interval = 60
tail = false
format = <label>
format-foreground = ${colors.purple}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --stealth-notify

[module/cpu]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-metrics
interval = 60
tail = false
format = <label>
format-foreground = ${colors.teal}
format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --cpu-notify

[module/memory]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-memory
interval = 60
tail = false
format = <label>
format-foreground = ${colors.purple}

format-padding = 0
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --mem-notify

[module/power]
type = custom/text
format = ⏻%{O2}
format-foreground = ${colors.red}

format-padding = 0
click-left = $HOME/.local/share/openriot/install/openriot --power-dropdown

[module/lock]
type = custom/text
format = 󰌾%{O2}
format-foreground = ${colors.fg2}

format-padding = 0
click-left = $HOME/.local/share/openriot/install/openriot --lock

