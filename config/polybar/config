; OpenRiot Polybar Config — Tokyo Night Theme for OpenBSD X11

[colors]
bg = #1a1b26
bg2 = #16161e
fg = #c0caf5
fg2 = #a9b1d6
fg3 = #7aa2f7
red = #f7768e
orange = #ff9e64
yellow = #e0af68
green = #9ece6a
cyan = #7dcfff
blue = #7aa2f7
purple = #bb9af7
light-purple = #9d7cd8
dark-purple = #7c3aed
darker-purple = #6c2bd9
violet = #bb9af7
disabled = #414868
separator = #414868

[global/wm]
margin-bottom = 5

[bar/main]
type = xcb
enable-ipc = true
fixed-center = true
width = 100%
height = 28
radius = 0
underline-size = 2
line-size = 2
padding-right = 0
padding-left = 0
padding-top = 3
module-margin = 0
spacing = 1

; Fonts - Nerd Font for icons, sans for text
font-0 = "Noto Sans:style=Bold:Antialias=true:size=9;2"
font-1 = "Noto Sans Nerd Font:style=Bold:Antialias=true:size=10;2"
font-2 = "Font Awesome 6 Free:style=Solid:Antialias=true:pixelsize=10;2"
font-3 = "Font Awesome 6 Brands:Antialias=true:pixelsize=10;2"

; Separator style
separator = ""
separator-padding = 0

; Modules layout: i3 workspaces | arrow | date | arrow | volume | network | battery | arrow | power
modules-left = launcher i3
modules-right = volume network battery openriot-update power

; Colors
background = ${colors.bg}
foreground = ${colors.fg}
line-color = ${colors.fg}

; ========================
; MODULES
; ========================

[module/i3]
type = internal/i3
pin-workspaces = true
strip-wsnumbers = true
index-sort = true
fuzzy-match = true

format = <label-state> <label-mode>
format-background = ${colors.dark-purple}

[module/launcher]
type = custom/text
content = " %{T1}󰀻%{T-} "
content-foreground = ${colors.fg}
content-background = ${colors.dark-purple}
click-left = $HOME/.local/share/openriot/config/rofi/launcher.sh
tooltip = App Launcher

label-mode = %mode%
label-mode-foreground = ${colors.fg}
label-mode-background = ${colors.dark-purple}

label-focused = 󰟠
label-focused-foreground = ${colors.fg}
label-focused-background = ${colors.dark-purple}
label-focused-padding = 3

label-unfocused = 󰊉
label-unfocused-foreground = ${colors.fg2}
label-unfocused-background = ${colors.dark-purple}
label-unfocused-padding = 3

label-visible = 󰊉
label-visible-foreground = ${colors.fg2}
label-visible-background = ${colors.dark-purple}
label-visible-padding = 3

label-urgent = 󰨏
label-urgent-foreground = ${colors.bg}
label-urgent-background = ${colors.red}
label-urgent-padding = 3

label-separator = ""
label-separator-padding = 0

[module/arrow-left]
type = custom/text
content = " %{T6}%{T-}"
content-font = 2
content-foreground = ${colors.dark-purple}
content-background = ${colors.bg}

[module/arrow-right]
type = custom/text
content = "%{T6} %{T-} "
content-font = 2
content-foreground = ${colors.dark-purple}
content-background = ${colors.bg}

[module/date]
type = internal/date
interval = 1
format = <label>
format-foreground = ${colors.fg}
format-background = ${colors.dark-purple}
format-padding = 3
date = " %{T1}󰥔%{T-} %d %a  %H:%M "

[module/volume]
type = custom/script
exec = $HOME/.local/share/openriot/install/openriot --polybar-volume
interval = 1
tail = true
format = <label>
format-foreground = ${colors.fg}
format-background = ${colors.dark-purple}
format-padding = 2
label = %output%
click-left = $HOME/.local/share/openriot/install/openriot --volume toggle
scroll-up = $HOME/.local/share/openriot/install/openriot --volume inc
scroll-down = $HOME/.local/share/openriot/install/openriot --volume dec

[module/network]
type = custom/script
exec = $HOME/.local/share/openriot/config/polybar/scripts/network.sh
interval = 30
tail = false
format = <label>
format-foreground = ${colors.fg}
format-background = ${colors.dark-purple}
format-padding = 2
label = %output%
tooltip = Network status

[module/battery]
type = custom/script
exec = $HOME/.local/share/openriot/config/polybar/scripts/battery.sh
interval = 30
tail = false
format = <label>
format-foreground = ${colors.fg}
format-background = ${colors.dark-purple}
format-padding = 2
label = %output%
tooltip = Battery status

[module/openriot-update]
type = custom/script
exec = $HOME/.local/share/openriot/config/polybar/scripts/openriot-update.sh
interval = 300
tail = false
format = <label>
format-foreground = ${colors.fg}
format-background = ${colors.dark-purple}
format-padding = 2
label = %output%
tooltip = OpenRiot update available
click-left = $HOME/.local/share/openriot/config/polybar/scripts/openriot-update.sh --click

[module/power]
type = custom/text
content = " %{T1}⏻%{T-} "
content-foreground = ${colors.fg}
content-background = ${colors.dark-purple}
click-left = $HOME/.local/share/openriot/install/openriot --power-menu
tooltip = Power menu
