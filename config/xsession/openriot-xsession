#!/bin/sh
# OpenRiot Xsession — for xenodm or startx
# OpenBSD X11

# Disable core dumps for all X11 processes
ulimit -c 0

export LC_CTYPE=en_US.UTF-8

# Set cursor theme
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# Force GTK apps to use dark theme
export GTK_THEME=Adwaita-dark

# Refresh font cache
fc-cache -f 2>/dev/null

# Create ~/Screenshots directory if it doesn't exist
mkdir -p ~/Screenshots

# Load Xresources
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Kill xconsole (annoying full-screen console on OpenBSD login)
pkill -f xconsole 2>/dev/null || true

# DPMS: monitor off at 30 min, lock at 10 min
xset s off
xset -dpms
xset dpms 0 0 1800
xset +dpms
xautolock -time 10 -locker "$HOME/.local/share/openriot/install/openriot --smart-lock" &

# # Configure trackpad pointer speed (lower = slower)
# doas wsconsctl mouse.tp.scaling=0.8 2>/dev/null || true

# Enable ThinkPad trackpoint middle-button scroll
if sysctl hw.vendor 2>/dev/null | grep -qiE 'lenovo|ibm|thinkpad'; then
    xinput set-prop "/dev/wsmouse" "WS Pointer Wheel Emulation" 1
    xinput set-prop "/dev/wsmouse" "WS Pointer Wheel Emulation Button" 2
    xinput set-prop "/dev/wsmouse" "WS Pointer Wheel Emulation Axes" 6 7 4 5
    xinput set-prop "/dev/wsmouse" "WS Pointer Middle Button Emulation" 3
fi

# Start i3
exec i3
