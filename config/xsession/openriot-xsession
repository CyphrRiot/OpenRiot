#!/bin/sh
# OpenRiot Xsession — for xenodm or startx
# OpenBSD X11

export LC_CTYPE=en_US.UTF-8

# Set cursor theme
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# Create ~/Screenshots directory if it doesn't exist
mkdir -p ~/Screenshots

# Load Xresources
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Disable DPMS (prevent screen power off)
xset -dpms

# Screensaver after 10 minutes, lock when activated
xset s 600

# Start D-Bus session (MUST be before xss-lock)
eval $(dbus-launch --sh-syntax)

# Lock screen when screensaver activates
xss-lock -- $HOME/.local/share/openriot/config/bin/openriot-lock.sh &

# Start i3
exec i3
