#!/bin/sh
# OpenRiot Xsession — for xenodm or startx
# OpenBSD X11

export LC_CTYPE=en_US.UTF-8

# Set cursor theme
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# Create ~/Screenshots directory if it doesn't exist
mkdir -p ~/Screenshots

# Load Xresources
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Disable DPMS (prevent screen power off)
xset -dpms

# Screensaver after 10 minutes
xset s 600

# Use xautolock to trigger i3lock (OpenBSD doesn't have xss-lock)
xautolock -time 10 -locker "$HOME/.local/share/openriot/install/openriot --lock" &
xset s on

# Start i3
exec i3
