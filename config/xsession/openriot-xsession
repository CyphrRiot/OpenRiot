#!/bin/sh
# OpenRiot Xsession — for xenodm or startx
# OpenBSD X11

export LC_CTYPE=en_US.UTF-8

# Set cursor theme
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# Force GTK apps to use dark theme
export GTK_THEME=Adwaita-dark

# Create ~/Screenshots directory if it doesn't exist
mkdir -p ~/Screenshots

# Load Xresources
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Kill xconsole (annoying full-screen console on OpenBSD login)
pkill -f xconsole 2>/dev/null || true

# DPMS: monitor off at 30 min, lock at 10 min
xset s off
xset -dpms
xset dpms 0 0 1800
xset +dpms
xautolock -time 10 -locker "$HOME/.local/share/openriot/config/bin/smart-lock" &

# Start i3
exec i3
