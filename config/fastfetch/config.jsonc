{
    "logo": {
        "source": "blowfish",
        "type": "builtin",
        "width": 20,
        "padding": {
            "top": 5,
            "right": 6,
        },
        "color": {
            "1": "magenta",
            "2": "magenta",
            "3": "magenta",
            "4": "magenta",
            "5": "magenta",
            "6": "magenta",
            "7": "magenta",
            "8": "magenta",
            "9": "magenta",
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "green",
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "showPeCoreCount": true,
            "keyColor": "green",
        },
        {
            "type": "gpu",
            "key": "│ ├",
            "detectionMethod": "pci",
            "keyColor": "green",
        },
        {
            "type": "display",
            "key": "│ ├[D]",
            "keyColor": "green",
        },
        {
            "type": "disk",
            "key": "│ ├[disk]",
            "keyColor": "green",
        },
        {
            "type": "memory",
            "key": "│ ├",
            "keyColor": "green",
        },
        {
            "type": "swap",
            "key": "└ └[S] ",
            "keyColor": "green",
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘",
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow",
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "yellow",
        },
        {
            "type": "packages",
            "key": "│ ├[PKG]",
            "keyColor": "yellow",
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "yellow",
        },
        "break",
        {
            "type": "de",
            "key": " DE",
            "keyColor": "blue",
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "blue",
        },
        {
            "type": "wmtheme",
            "key": "│ ├[THEME]",
            "keyColor": "blue",
        },
        {
            "type": "icons",
            "key": "│ ├[ICON]",
            "keyColor": "blue",
        },
        {
            "type": "cursor",
            "key": "│ ├",
            "keyColor": "blue",
        },
        {
            "type": "terminalfont",
            "key": "│ ├",
            "keyColor": "blue",
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "blue",
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘",
        },
        "break",
    ],
}
