{
    "logo": {
        "source": "openbsd_small",
        "type": "builtin",
        "width": 20,
        "padding": {
            "top": 5,
            "right": 6,
        },
        "color": {
            "1": "magenta",
            "2": "magenta",
            "3": "magenta",
            "4": "magenta",
            "5": "magenta",
            "6": "magenta",
            "7": "magenta",
            "8": "magenta",
            "9": "magenta",
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────Hardware──────────────────────┐",
        },
        {
            "type": "cpu",
            "key": " CPU",
            "showPeCoreCount": true,
            "keyColor": "green",
        },
        {
            "type": "gpu",
            "key": " GPU",
            "detectionMethod": "pci",
            "keyColor": "green",
        },
        {
            "type": "memory",
            "key": " RAM",
            "keyColor": "green",
        },
        {
            "type": "swap",
            "key": " SWP",
            "keyColor": "green",
        },
        {
            "type": "disk",
            "key": " DSK",
            "keyColor": "cyan",
            "showName": true,
            "showUsed": true,
            "showPercent": true,
            "showTotal": true,
            "mountPoints": ["/", "/home"]
        },
        {
            "type": "localip",
            "key": " IP",
            "keyColor": "cyan",
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────┘",
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────General Configuration───────────────┐",
        },
        {
            "type": "os",
            "key": " OS Ver",
            "keyColor": "magenta",
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "magenta",
        },
        {
            "type": "uptime",
            "key": " Uptime",
            "keyColor": "cyan",
        },
        {
            "type": "wm",
            "key": " WinMgr",
            "keyColor": "magenta",
        },
        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "magenta",
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────┘",
        },
        "break",
    ],
}
